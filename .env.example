# ─── LLM Provider ──────────────────────────────────────────────
# Choose ONE provider: "claude", "codex", "openrouter", "deepseek", or "minimax"
LLM_PROVIDER=codex

# Claude OAuth (LLM_PROVIDER=claude)
#   No API key needed — use the Claude CLI and sign in there first.
#   Model aliases: opus, sonnet, haiku

# Codex OAuth (LLM_PROVIDER=codex)
#   No API key needed — run 'codex login' to authenticate via OAuth.
#   Uses your ChatGPT Plus/Pro/Team subscription.
#   Token is read automatically from ~/.codex/auth.json.
#   Model names use OpenAI format: gpt-4o, gpt-5.4, etc.

# OpenRouter (LLM_PROVIDER=openrouter)
#   OPENROUTER_API_KEY=sk-or-...
#   Model names use OpenRouter format: openai/gpt-5.4-nano, deepseek/deepseek-v3.2-speciale, etc.

# DeepSeek (LLM_PROVIDER=deepseek)
#   DEEPSEEK_API_KEY=sk-...
#   OpenAI-compatible endpoint: https://api.deepseek.com
#   Model names: deepseek-v4-pro (top tier), deepseek-v4-flash
#   (deepseek-chat / deepseek-reasoner are deprecated 2026-07-24)

# MiniMax Token Plan (LLM_PROVIDER=minimax)
#   MINIMAX_API_KEY=...
#   OpenAI-compatible endpoint: https://api.minimax.io/v1
#   Model names: MiniMax-M2.7, MiniMax-M2.7-highspeed, MiniMax-M2.5, etc.

# Optional: override default model for all roles
# LLM_MODEL=gpt-4o

# ─── Solana ────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_key
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_key
HELIUS_API_KEY=your_helius_api_key

# ─── Optional Services ────────────────────────────────────────
# JUPITER_API_KEY=your_jupiter_api_key   # Jupiter swap v2 / quote / price API key
# LPAGENT_API_KEY=your_lpagent_key       # LP Agent. Use ONE key: keys from multiple accounts break LPAgent ToS §7 (https://docs.lpagent.io/terms-of-service.md). Upgrade the plan for more throughput.
# LPAGENT_RPM=5                          # LP Agent requests/min per key: Basic 5, Premium 10, Enterprise 20
# TELEGRAM_BOT_TOKEN=123456:ABC...       # Telegram notifications + control
# TELEGRAM_CHAT_ID=123456789             # Owner chat (only chat that can control the bot; user-config telegramChatId wins)
# TELEGRAM_ALLOWLIST=111,222             # Extra user ids allowed to act inside the owner chat (needed for group chats)
# WEB_PORT=3737                          # Web dashboard port
# LOG_LEVEL=info                         # Logging verbosity
# SOLANATRACKER_API_KEY=your_key         # Optional, free plan is enough. Token candles for range depth (rangeDepthMode "ohlcv"),
#                                        # used only when GMGN has no candles; capped by solanaTrackerDailyCap (default 60/day).
#                                        # Unset = SolanaTracker is skipped quietly (GMGN / GeckoTerminal / Meteora still work).

# ─── Mode ──────────────────────────────────────────────────────
DRY_RUN=true                             # true = simulate, false = live on-chain
# USDC_MODE=false                        # true = hold capital in USDC, swap to SOL on entry & settle back on exit (SOL-quoted pools either way). Also settable as "usdcMode" in user-config.json
# DASHBOARD_TOKEN=                       # required for fund-moving actions from the web dashboard / Telegram
