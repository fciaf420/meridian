# Secrets and endpoints ONLY. Every other setting lives in user-config.json
# and is editable from Telegram (Menu -> Settings console), no redeploy needed.
# Copy to .env and fill in the three required lines.

# ─── Required ─────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_key
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_key
TELEGRAM_BOT_TOKEN=123456:ABC...

# ─── LLM key (only for the provider you pick in user-config.json "llmProvider") ──
#   claude / codex use OAuth (run 'claude' / 'codex login' once): no key needed.
# OPENROUTER_API_KEY=sk-or-...
# DEEPSEEK_API_KEY=sk-...
# MINIMAX_API_KEY=...

# ─── Optional data / infra keys ───────────────────────────────
# GMGN_API_KEY=...                       # needed when screeningSource is "gmgn" or "both"
# HELIUS_API_KEY=your_helius_api_key
# JUPITER_API_KEY=your_jupiter_api_key   # Jupiter swap v2 / quote / price API key
# LPAGENT_API_KEY=your_lpagent_key       # LP Agent. Use ONE key (multiple accounts break LPAgent ToS §7).
# LPAGENT_RPM=5                          # LP Agent requests/min per key: Basic 5, Premium 10, Enterprise 20
# SOLANATRACKER_API_KEY=your_key         # optional token-candle fallback (free plan is enough)
# BALANCE_RPC_URL=https://eu.fluxrpc.com?key=your_flux_key   # separate RPC for wallet-balance reads only
# DASHBOARD_TOKEN=                       # required for fund-moving actions from the web dashboard / Telegram
# TELEGRAM_CHAT_ID=123456789             # owner chat (default: first private chat to message the bot; user-config telegramChatId wins)
# TELEGRAM_ALLOWLIST=111,222             # extra user ids allowed inside the owner chat (group chats)

# ─── Ops (see ops/README.md) ──────────────────────────────────
# LOG_LEVEL=info
# SHUTDOWN_DRAIN_TIMEOUT_SEC=90
# HEALTHCHECK_URL=https://hc-ping.com/your-check-uuid
# HEALTHCHECK_EVERY_TICKS=10

# ─── Deprecated (still read for one more release, with a warning) ──────────
# DRY_RUN, USDC_MODE, LLM_PROVIDER, LLM_MODEL, WEB_PORT now live in user-config.json
# (dryRun, usdcMode, llmProvider, llmModel, webPort). If both are set, user-config.json WINS.
